# Copier ce fichier en .env puis remplacer les valeurs. .env n'est jamais versionné.

# Domaine HTTPS servi par Traefik. En local, l'ajouter au fichier hosts (127.0.0.1 madehospital.sn orthanc.madehospital.sn).
# Le certificat doit exister dans traefik/certs/ (voir scripts/generer-certificats.sh).
APP_DOMAIN=madehospital.sn

# Base de données PostgreSQL
POSTGRES_DB=hopital
POSTGRES_USER=madehospital
POSTGRES_PASSWORD=a-remplacer

# Clé de signature des jetons JWT (au moins 32 caractères). Générer avec : openssl rand -base64 48
JWT_SECRET=a-remplacer-par-une-longue-cle-aleatoire-de-48-caracteres

# Compte d'accès à Orthanc (utilisé par le backend et pour l'interface https://orthanc.<APP_DOMAIN>)
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=a-remplacer

# Premier administrateur, créé au démarrage du backend s'il n'existe pas encore.
# Sans email ou sans mot de passe, aucun compte n'est créé. Changer le mot de passe après la première connexion.
INITIAL_ADMIN_EMAIL=admin@madehospital.sn
INITIAL_ADMIN_PASSWORD=a-remplacer
INITIAL_ADMIN_NOM=Administrateur
INITIAL_ADMIN_PRENOM=Principal
INITIAL_ADMIN_TELEPHONE=
INITIAL_ADMIN_DEPARTEMENT=Direction

# Adresse publique (QR code de vérification imprimé sur les documents)
APP_URL_PUBLIQUE=https://madehospital.sn
